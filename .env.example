PORT=4000
DATABASE_URL=postgresql://user:password@host/db?sslmode=require&uselibpqcompat=true
JWT_SECRET=change-this-secret-in-production
FRONTEND_URL=http://localhost:3000

# Apex domain factories are given a subdomain under (acme.kayanflow.com).
ROOT_DOMAIN=localhost:3000

# --- Stripe ------------------------------------------------------------------
# Without STRIPE_SECRET_KEY, self-serve signup is disabled and only an admin
# can provision factories.
STRIPE_SECRET_KEY=sk_test_...

# From `stripe listen --forward-to localhost:4000/api/billing/webhook`,
# or from the webhook endpoint you create in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# Note: there are no price ids here. Plans are rows in the `plans` table,
# managed from the admin panel, and each plan stores its own Stripe product and
# price ids. `npm run stripe:sync` pushes the catalog into Stripe.
