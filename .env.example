PORT=4000
DATABASE_URL=postgresql://user:password@host/db?sslmode=require&uselibpqcompat=true
JWT_SECRET=change-this-secret-in-production
FRONTEND_URL=http://localhost:3000

# Apex domain factories are given a subdomain under (acme.kayanflow.com).
ROOT_DOMAIN=localhost:3000

# --- Paddle (Merchant of Record) ---------------------------------------------
# Without PADDLE_API_KEY, self-serve signup is disabled and only an admin can
# provision factories.
# Sandbox and production are SEPARATE Paddle accounts with separate keys.
PADDLE_API_KEY=pdl_sdbx_apikey_...
PADDLE_ENVIRONMENT=sandbox
PADDLE_CURRENCY=USD

# Paddle Dashboard > Developer tools > Notifications > create a destination
# pointing at {your-api}/api/billing/webhook, then copy its secret key here.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_..._...

# Note: there are no price ids here. Plans are rows in the `plans` table,
# managed from the admin panel, and each plan stores its own Paddle product and
# price ids. `npm run paddle:sync` pushes the catalog into Paddle.

# --- WhatsApp automation -----------------------------------------------------
# Meta must be able to REACH the webhook, so in development this is a tunnel
# (e.g. `ngrok http 4000`), not localhost. Shown to factories on the configure
# page as the URL to paste into Meta.
PUBLIC_API_URL=https://your-api.example.com

# Encrypts stored WhatsApp access tokens at rest: openssl rand -hex 32
# Without it a key is derived from JWT_SECRET, so rotating JWT_SECRET would
# make stored tokens undecryptable. Always set this in production.
ENCRYPTION_KEY=

# Powers the automatic replies. Without it, messages are still captured and
# shown in the inbox, but nothing is answered automatically.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
