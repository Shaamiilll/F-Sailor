PORT=4000
DATABASE_URL=postgresql://user:password@host/db?sslmode=require&uselibpqcompat=true
JWT_SECRET=change-this-secret-in-production
FRONTEND_URL=http://localhost:3000

# Apex domain factories are given a subdomain under (acme.kayanflow.com).
ROOT_DOMAIN=localhost:3000

# --- Paddle (Merchant of Record) ---------------------------------------------
# Without PADDLE_API_KEY, self-serve signup is disabled and only an admin can
# provision factories.
# Sandbox and production are SEPARATE Paddle accounts with separate keys.
PADDLE_API_KEY=pdl_sdbx_apikey_...
PADDLE_ENVIRONMENT=sandbox
PADDLE_CURRENCY=USD

# Paddle Dashboard > Developer tools > Notifications > create a destination
# pointing at {your-api}/api/billing/webhook, then copy its secret key here.
PADDLE_WEBHOOK_SECRET=pdl_ntfset_..._...

# Note: there are no price ids here. Plans are rows in the `plans` table,
# managed from the admin panel, and each plan stores its own Paddle product and
# price ids. `npm run paddle:sync` pushes the catalog into Paddle.
